      </inputformats>
      <property name="Ext" value=".p06" />
    </description>
    <presets>
      <preset name="Default" cmdparams="--id 06 &quot;double quoted&quot; 'single quoted' %choice% -o %output% -" default="1">
        <var name="Choice" cmdparams="%choice%">
          <val name="Empty" cmdparams="" default="1" />
          <val name="Marker" cmdparams="--marker" />
        </var>
      </preset>
    </presets>
  </encoder>
