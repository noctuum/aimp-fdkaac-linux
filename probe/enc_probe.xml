<?xml version="1.0" encoding="utf-8" ?>
<encoders generator="AIMP" version="1000" name="Probe v1" author="probe" info="Probe of the command-line encoder host">
  <encoder Name="Probe 01 baseline" App="probe_root.exe">
    <description>
      <inputformats type="autogen">
        <autogen SampleRates="8000;11025;12000;16000;22050;24000;32000;44100;48000;64000;88200;96000;176400;192000" SampleFormats="8;16;24;32;32f" Channels="1;2;3;4;5;6;7;8" />
      </inputformats>
      <property name="Ext" value=".p01" />
    </description>
    <presets>
      <preset name="Default" cmdparams="--id 01 -o %output% -" default="1" />
    </presets>
  </encoder>
