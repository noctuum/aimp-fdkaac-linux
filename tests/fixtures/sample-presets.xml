<?xml version="1.0" encoding="utf-8" ?>
<encoders generator="AIMP" version="1000" name="AAC/M4A Encoder (FDK) v1.0.9" author="sample" info="Using nu774's fdkaac (https://github.com/nu774/fdkaac) with the Fraunhofer FDK AAC library (https://github.com/mstorsjo/fdk-aac)">
	<encoder Name="AAC-LC (FDK)" App="fdkaac-aimp.exe">
		<description>
			<inputformats type="autogen">
				<autogen SampleRates="8000;11025;12000;16000;22050;24000;32000;44100;48000;64000;88200;96000" SampleFormats="16" Channels="1;2" />
			</inputformats>
			<property name="Ext" value=".m4a" />
			<property name="IgnoreLength" value="1" />
		</description>
		<presets>
			<preset name="VBR" cmdparams="-p 2 -m %mode% -I -S -o %output% -">
				<var name="Mode" cmdparams="%mode%">
					<val name="3" cmdparams="3" />
					<val name="5" cmdparams="5" default="1" />
				</var>
			</preset>
			<preset name="CBR" cmdparams="-p 2 -b %bitrate% -I -S -o %output% -">
				<var name="Bitrate" cmdparams="%bitrate%">
					<val name="128" cmdparams="128" />
					<val name="256" cmdparams="256" default="1" />
				</var>
			</preset>
		</presets>
	</encoder>
	<encoder Name="HE-AAC (FDK)" App="fdkaac-aimp.exe">
		<description>
			<inputformats type="autogen">
				<autogen SampleRates="16000;22050;24000;32000;44100;48000" SampleFormats="16" Channels="1;2" />
			</inputformats>
			<property name="Ext" value=".m4a" />
			<property name="IgnoreLength" value="1" />
		</description>
		<presets>
			<preset name="VBR" cmdparams="-p 5 -m 2 -I -S -o %output% -" />
		</presets>
	</encoder>
	<encoder Name="HE-AAC v2 (FDK)" App="fdkaac-aimp.exe">
		<description>
			<inputformats type="autogen">
				<autogen SampleRates="16000;22050;24000;32000;44100;48000" SampleFormats="16" Channels="2" />
			</inputformats>
			<property name="Ext" value=".m4a" />
			<property name="IgnoreLength" value="1" />
		</description>
		<presets>
			<preset name="VBR" cmdparams="-p 29 -m 1 -I -S -o %output% -" />
		</presets>
	</encoder>
</encoders>
